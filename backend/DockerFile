
FROM node:24-alpine

WORKDIR /app

# Install dependencies first for better layer caching
COPY package*.json ./
RUN npm ci --omit=dev

# Copy backend source and SQL schema
COPY src ./src
COPY sql ./sql
COPY scripts ./scripts

ENV NODE_ENV=production

# Render and Docker can provide the port through PORT
EXPOSE 4000

CMD ["npm", "start"]
